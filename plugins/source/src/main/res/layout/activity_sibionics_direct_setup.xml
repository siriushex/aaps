<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sibionics_direct_setup_header"
            android:textAppearance="@android:style/TextAppearance.Medium" />

        <Switch
            android:id="@+id/sibionicsDirectEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sibionics_direct_enable_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sibionics_direct_subtype_label" />

        <Spinner
            android:id="@+id/sibionicsDirectSubtype"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sibionics_direct_device_name_label" />

        <EditText
            android:id="@+id/sibionicsDirectDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sibionics_direct_device_name_hint"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sibionics_direct_device_address_label" />

        <EditText
            android:id="@+id/sibionicsDirectDeviceAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sibionics_direct_device_address_hint"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sibionics_direct_poll_interval_label" />

        <EditText
            android:id="@+id/sibionicsDirectPollInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sibionics_direct_next_index_label" />

        <EditText
            android:id="@+id/sibionicsDirectNextIndex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sibionics_direct_transmitter_code_label" />

        <EditText
            android:id="@+id/sibionicsDirectTransmitterCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/sibionics_direct_transmitter_code_hint"
            android:inputType="textNoSuggestions"
            android:maxLines="2" />

        <Button
            android:id="@+id/sibionicsDirectParseCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sibionics_direct_parse_code" />

        <CheckBox
            android:id="@+id/sibionicsDirectResetRequested"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sibionics_direct_reset_requested" />

        <TextView
            android:id="@+id/sibionicsDirectStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sibionicsDirectCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@android:string/cancel" />

            <Button
                android:id="@+id/sibionicsDirectSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@android:string/ok" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
